{
  "version": "2.0.0",
  "tasks": [
    {
      "label": "Rust: expand current file",
      "type": "process",
      "command": "pwsh",
      "args": [
        "-NoProfile",
        "-ExecutionPolicy",
        "Bypass",
        "-File",
        "${workspaceFolder}/scripts/expand-current.ps1",
        "-FilePath",
        "${file}"
      ],
      "windows": {
        "command": "powershell"
      },
      "presentation": {
        "reveal": "always",
        "panel": "shared",
        "clear": true
      },
      "problemMatcher": []
    }
  ]
}
